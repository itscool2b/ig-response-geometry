# These immutable analysis artifacts carry byte-level hashes. Git must not
# translate their line endings when checking out on Windows.
analysis/revision/results/** -text
# provenance.json records the analysis code's hashes, which a translated checkout would change.
analysis/revision/** -text
analysis/revision/nested_grid_aliasing.py -text
analysis/revision/examples/** -text
analysis/paired_rescoring/** -text
# Saved numerical projections and their reproducer use exact-byte manifests.
analysis/numerical_case/** -text
analysis/manuscript_revision/** -text
paper/nhsjs.bst -text
# Manuscript lineage authenticates exact generated and source bytes too.
paper/paper.tex -text
paper/appendix_aliasing.tex -text
paper/references.bib -text
paper/arxiv_abstract.txt -text
paper/tables_revision/** -text
paper/figures_revision/** -text
paper/tmlr.sty -text
paper/tmlr.bst -text
paper/tmlr-LICENSE -text
paper/tmlr-source.json -text
scripts/build_revision_assets.py -text
scripts/build_nhsjs_revision_assets.py -text
paper/supplementary_derivations.tex -text
# Replay validation binds these source and runtime bytes in the review archive.
scripts/reviewer_interval_certificate.py -text
scripts/verify_reviewer_replay.py -text
scripts/reproduce_reviewer_archive.py -text
requirements-replay-linux.txt -text
# The aliasing/manuscript lineage also authenticates this shared core's bytes.
integrated_gradients.py -text
# Preserved source files have an exact-byte archive manifest.
legacy/** -text
# Shell entrypoints must remain executable after a Windows checkout/upload.
scripts/*.sh text eol=lf

# NHSJS-R1 GPU analysis code and hash-bound results.
analysis/revision_gpu/** -text
# CPU revision analyses of 2026-10-23 carry byte-level hashes too.
analysis/completeness_audit/** -text
analysis/language_groups/** -text
# The public NHSJS revision protocols and regeneration records are bound by SHA-256.
docs/nhsjs-revision/** -text
# The archived historical IG kernel is compared bit for bit with the A0 replica.
docs/tmlr-readiness/** -text
