# These immutable analysis artifacts carry byte-level hashes. Git must not
# translate their line endings when checking out on Windows.
analysis/revision/results/** -text
# Saved numerical projections and their reproducer use exact-byte manifests.
analysis/numerical_case/** -text
# Manuscript lineage authenticates exact generated and source bytes too.
paper/paper.tex -text
paper/arxiv_abstract.txt -text
paper/tables_revision/** -text
paper/figures_revision/** -text
scripts/build_revision_assets.py -text
# Preserved source files have an exact-byte archive manifest.
legacy/** -text
# Shell entrypoints must remain executable after a Windows checkout/upload.
scripts/*.sh text eol=lf
